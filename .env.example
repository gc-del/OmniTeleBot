# ==============================================================================
# Bobacbot 环境变量与网络硬件配置模板
# 复制为 .env 并根据现场网络和机器人硬件调整
# ==============================================================================

# 机器人 WebSocket 服务端地址 (ECO65 / 底盘控制器)
ROBOT_WS_URL=ws://127.0.0.1:6060

# 视觉与相机通信配置 (ZMQ 图像流)
IMAGE_HOST=127.0.0.1
HAND_CAM_PORT=55555
BASE_CAM_PORT=55556

# RPC 服务通讯 (底盘与机械臂低层控制)
BASE_RPC_HOST=localhost
BASE_RPC_PORT=50000
ARM_RPC_HOST=localhost
ARM_RPC_PORT=50001
RPC_AUTHKEY=CHANGE_THIS_SECRET_KEY

# 硬件臂通讯 (Kinova 等硬件直连 IP)
ARM_IP_ADDRESS=192.168.1.10
ARM_TCP_PORT=10000
ARM_UDP_PORT=10001
ARM_USERNAME=admin
ARM_PASSWORD=admin

# 策略推理服务器配置
POLICY_SERVER_HOST=localhost
POLICY_SERVER_PORT=5555
