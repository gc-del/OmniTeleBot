    <body name="competition_cabinet" pos="-1.55 1.54 -0.45" euler="1.5708 0 0">
      <!-- Outer shell panels, each 10mm thick. Position = center of outer and inner faces -->
      <!-- Y: outer=[0.449,1.019], inner=[0.459,1.009]; X: outer=[0.350,1.070], inner=[0.360,1.060]; Z: outer=[0.040,0.250], inner=[0.050,0.250] -->
