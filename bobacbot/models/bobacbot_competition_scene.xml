      <geom name="cabinet_inner_r" type="box" pos="1.060 0.734 0.150" size="0.003 0.275 0.100" rgba="0 0 0 0" contype="1" conaffinity="1"/>
      <!-- Middle shelf: Y faces at 0.899(bottom) and 0.909(top), 10mm thick -->
      <geom name="cabinet_shelf_mid" type="box" pos="0.710 0.904 0.150" size="0.350 0.005 0.100" rgba="0 0 0 0" contype="1" conaffinity="1"/>
      <!-- Top-level center dividers: only in Y=[0.909,1.009], each 10mm thick -->
      <geom name="cabinet_div_1" type="box" pos="0.600 0.959 0.150" size="0.005 0.050 0.100" rgba="0 0 0 0" contype="1" conaffinity="1"/>
      <geom name="cabinet_div_2" type="box" pos="0.820 0.959 0.150" size="0.005 0.050 0.100" rgba="0 0 0 0" contype="1" conaffinity="1"/>
      <!-- Front frame at Z=0.250: edges at outer faces forming the front opening -->
      <geom name="cabinet_front_top"   type="box" pos="0.710 1.019 0.250" size="0.350 0.003 0.003" rgba="0 0 0 0" contype="1" conaffinity="1"/>
      <geom name="cabinet_front_bot"   type="box" pos="0.710 0.449 0.250" size="0.350 0.003 0.003" rgba="0 0 0 0" contype="1" conaffinity="1"/>
