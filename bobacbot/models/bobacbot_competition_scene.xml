      <geom name="trash2_wall_b" type="box" pos="2.879 0.482 1.898" size="0.09 0.002 0.10" rgba="0 0 0 0" contype="1" conaffinity="1"/>
      <geom name="trash2_wall_r" type="box" pos="2.969 0.572 1.898" size="0.002 0.09 0.10" rgba="0 0 0 0" contype="1" conaffinity="1"/>
