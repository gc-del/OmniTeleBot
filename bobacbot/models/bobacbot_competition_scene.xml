      <geom name="wall_bottom" type="box" size="1.53 0.20 0.01" pos="1.55 0.649 0.01" rgba="0 0 0 0" contype="1" conaffinity="1"/>
      <geom name="wall_right"  type="box" size="0.01 0.20 1.53" pos="3.08 0.649 1.54" rgba="0 0 0 0" contype="1" conaffinity="1"/>
      <geom name="wall_top_r"  type="box" size="0.515 0.20 0.01" pos="2.565 0.649 3.07" rgba="0 0 0 0" contype="1" conaffinity="1"/>
      <geom name="wall_top_l"  type="box" size="0.515 0.20 0.01" pos="0.535 0.649 3.07" rgba="0 0 0 0" contype="1" conaffinity="1"/>
