      <geom name="cabinet_wall_r"   type="box" pos="1.065 0.734 0.145" size="0.005 0.285 0.105" rgba="0 0 0 0" contype="1" conaffinity="1"/>
      <geom name="cabinet_wall_bot" type="box" pos="0.710 0.454 0.145" size="0.360 0.005 0.105" rgba="0 0 0 0" contype="1" conaffinity="1"/>
